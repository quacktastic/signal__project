@startuml
skinparam classAttributeIconSize 0

interface DataListener {
    + startListening() : void
    + stopListening() : void
    + isListening() : boolean
}

class ConsoleDataListener implements DataListener {
    + ConsoleDataListener()
    + startListening() : void
    + stopListening() : void
    + isListening() : boolean
}

class FileDataListener implements DataListener {
    - filePath : String
    + FileDataListener(filePath : String)
    + startListening() : void
    + stopListening() : void
    + isListening() : boolean
}

class TcpDataListener implements DataListener {
    - serverIp : String
    - port : int
    + TcpDataListener(serverIp : String, port : int)
    + startListening() : void
    + stopListening() : void
    + isListening() : boolean
}

class WebSocketDataListener implements DataListener {
    - endpointUri : String
    + WebSocketDataListener(endpointUri : String)
    + startListening() : void
    + stopListening() : void
    + isListening() : boolean
}

class DataParser {
    + parse(rawData : String) : PatientData
}

class PatientData {
    - patientId : String
    - metrics : Map<String, Double>
    - timestamp : long
    + PatientData(patientId : String, metrics : Map<String, Double>, timestamp : long)
    + getPatientId() : String
    + getMetrics() : Map<String, Double>
    + getTimestamp() : long
}

class DataSourceAdapter {
    - sourceType : String
    - activeListener : DataListener
    - parser : DataParser
    - dataStorage : DataStorage
    + DataSourceAdapter(sourceType : String, listener : DataListener, parser : DataParser, dataStorage : DataStorage)
    + onDataReceived(rawData : String) : void
    + getSourceType() : String
}

class DataStorage {
    - patientDataMap : Map<String, List<PatientData>>
    + storeData(data : PatientData) : void
    + retrieveData(patientId : String) : List<PatientData>
    + deleteData(patientId : String) : void
    - executeSecureChannelWrite() : void
}

'--- Associations & Dependencies ---
DataSourceAdapter "1" --> "1" DataListener : "manages & receives stream from"
DataSourceAdapter "1" --> "1" DataParser : "delegates parsing to"
DataSourceAdapter "1" --> "1" DataStorage : "forwards parsed data to"

DataParser ..> PatientData : "instantiates"
DataSourceAdapter ..> PatientData : "routes"
DataStorage o-- "0..*" PatientData : "stores"

@enduml